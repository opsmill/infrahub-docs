# Lychee link checker ignore patterns
# https://github.com/lycheeverse/lychee

# Local development URLs
http://localhost:8000
http://localhost:8080
http://localhost:8501
# Grafana from the observability stack guide
http://localhost:3500

# Example domains
http://example.com
https://example.com
http://example.org
https://example.org

# Common placeholder URLs
https://your-infrahub-instance.com
https://infrahub.example.com

# GitHub edit/tree/blob links (cause rate limiting)
https://github.com/.*/edit/.*
https://github.com/.*/tree/.*
https://github.com/.*/blob/.*
https://github.com/opsmill/.*/tree/stable/docs/.*

# Nautobot API docs requires auth
https://demo.nautobot.com/api/docs

# Google APIs
https://.*.googleapis.com/.*

# Social media that may block bots
https://twitter.com
https://x.com
https://linkedin.com

# URLs that commonly have rate limiting
https://registry.npmjs.org
# Returns 429 to automated requests (Cloudflare bot challenge)
^https://docs\.ansible\.com/
# Limits unauthenticated requests per IP address, so shared CI runners get 429
^https://gitlab\.com/

# Schema library v2.0.0 release notes: opsmill/schema-library has no v2.0.0 tag
^https://github\.com/opsmill/schema-library/compare/v1\.4\.11\.\.\.v2\.0\.0$

# Telemetry API endpoint listed as a configuration default, not a page
https://telemetry.opsmill.cloud/infrahub

# GitHub adds the #readme anchor with JavaScript, so it is not in the HTML
^https://github\.com/[^/]+/[^/]+#readme$

# Anchor links that may be dynamically generated
#.*
